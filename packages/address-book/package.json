{
  "name": "blockchain-addressbook",
  "version": "0.54.18",
  "description": "A collection of useful addresses on various chains for defi development",
  "type": "module",
  "main": "./build/esm/address-book/index.js",
  "types": "./build/esm/address-book/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/esm/address-book/index.js",
      "types": "./build/esm/address-book/index.d.ts",
      "require": "./build/cjs/address-book/index.js"
    },
    "./*": {
      "import": "./build/esm/address-book/*/index.js",
      "types": "./build/esm/address-book/*/index.d.ts",
      "require": "./build/cjs/address-book/*/index.js"
    },
    "./utils": {
      "import": "./build/esm/util/index.js",
      "types": "./build/esm/util/index.d.ts",
      "require": "./build/cjs/util/index.js"
    }
  },
  "files": ["./build"],
  "repository": "beefyfinance/beefy-api",
  "license": "MIT",
  "scripts": {
    "addChain": "bun run ./scripts/addChain.ts",
    "build:cjs": "tsc --project tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > ./build/cjs/package.json",
    "build:esm": "tsc --project tsconfig.esm.json && echo '{\"type\": \"module\"}' > ./build/esm/package.json",
    "checksum": "bun run ./scripts/checksum.ts",
    "checkDecimals": "bun run --transpileOnly ./scripts/checkDecimals.ts",
    "checkOracles": "bun run --transpileOnly scripts/checkOracles.ts",
    "checkDuplicates": "bun run --transpileOnly ./scripts/checkDuplicates.ts",
    "submit": "bun run checksum && bun run build && bun run publish",
    "test": "bun run test:ts && bun run test:lint",
    "test:ts": "bun run test:ts:cjs && bun run test:ts:esm",
    "test:ts:cjs": "tsc --noEmit --project tsconfig.cjs.json",
    "test:ts:esm": "tsc --noEmit --project tsconfig.esm.json",
    "test:lint": "bun run lint",
    "lint": "bun run lint:eslint:check && bun run lint:prettier:check",
    "lint:prettier:check": "prettier --check ./{src,scripts}/**/*.ts",
    "lint:prettier:fix": "prettier --write ./{src,scripts}/**/*.ts",
    "lint:eslint:check": "eslint",
    "lint:eslint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@ethereumjs/util": "^9.0.3",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.14.7",
    "cross-env": "^7.0.3",
    "eslint": "^9.5.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2",
    "typescript-eslint": "^7.13.1"
  },
  "packageManager": "bun@1.2.14"
}
